			MX91_PAD_GPIO_IO19__SAI3_RX_SYNC		0x051E
			MX91_PAD_GPIO_IO20__SAI3_RX_DATA0		0x051E
			MX91_PAD_GPIO_IO21__SAI3_TX_DATA0		0x051E
		>;
