			MX91_PAD_GPIO_IO26__USDHC3_DATA2	0x138e
			MX91_PAD_GPIO_IO27__USDHC3_DATA3	0x138e
		>;
	};

	pinctrl_usdhc3_200mhz: usdhc3-200mhzgrp {
